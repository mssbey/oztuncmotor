# ── Veritabanı ──────────────────────────────────────────────
DATABASE_URL="postgresql://oztunc:oztunc_dev_password@localhost:5440/oztunc?schema=public"
# Testler bu veritabanını sıfırlar; asla üretim veritabanını yazmayın.
TEST_DATABASE_URL="postgresql://oztunc:oztunc_dev_password@localhost:5440/oztunc_test?schema=public"

# ── Site ────────────────────────────────────────────────────
# Alan adı belirlenene kadar BOŞ bırakın: boşken canonical, sitemap URL'leri,
# Open Graph mutlak adresleri ve yapılandırılmış veri yayımlanmaz.
SITE_URL=""

# Formlardaki spam belirteci ve IP özetleri için gizli anahtar (en az 32 karakter).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="degistirin-en-az-32-karakter-rastgele-bir-deger"

# ── Görsel depolama ─────────────────────────────────────────
# local: dosyalar UPLOAD_DIR klasörüne yazılır (kalıcı diskli sunucu/VPS için)
# s3:    S3 uyumlu depolama (AWS S3, Cloudflare R2, MinIO…) — sunucusuz barındırmada zorunlu
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Bucket'ın herkese açık temel adresi, ör. https://cdn.ornek.com
S3_PUBLIC_URL=""

# ── E-posta bildirimleri (SMTP) ─────────────────────────────
# SMTP_HOST boşsa e-postalar gönderilmez; bildirimler kuyrukta bekler.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Öztunç Motor <bildirim@ornek.com>"

# Bekleyen bildirimleri yeniden deneyen uç nokta için gizli anahtar:
# POST /api/cron/notifications  (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Seed: "demo" yalnızca geliştirme ortamında (NODE_ENV != production) demo ürün/hizmet verisi ekler.
# Üretimde "base" kullanın; demo veri üretimde hiçbir koşulda eklenmez.
SEED_MODE="demo"

# Üretimde demo kayıtlar gizlidir. Yalnızca hazırlık (staging) ortamında, "DEMO" etiketiyle
# göstermek için "true" yapın. Canlı sitede ASLA açmayın.
SHOW_DEMO_CONTENT=""

# scripts/retry-notifications.ts için sitenin adresi (varsayılan http://localhost:3000)
APP_URL=""
